# Class: <http://purl.obolibrary.org/obo/CHEBI_24431> (<http://purl.obolibrary.org/obo/CHEBI_24431>)

SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_24431> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Class: <http://purl.obolibrary.org/obo/CHEBI_36080> (<http://purl.obolibrary.org/obo/CHEBI_36080>)

EquivalentClasses(<http://purl.obolibrary.org/obo/CHEBI_36080> <http://purl.obolibrary.org/obo/PR_000000001>)

# Class: <http://purl.obolibrary.org/obo/GO_0003674> (molecular_function)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/GO_0003674> "This is the same as GO molecular function"@en)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0003674> "GO:0005554")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0003674> "molecular_function")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0003674> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <http://purl.obolibrary.org/obo/GO_0005488> (binding)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005488> "binding")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005488> <http://purl.obolibrary.org/obo/GO_0003674>)

# Class: <http://purl.obolibrary.org/obo/GO_0005515> (protein binding)

AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0005515> "GO:0001948")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0005515> "GO:0045308")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005515> "protein binding")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0005515> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0005488> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004009> <http://purl.obolibrary.org/obo/PR_000000001>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0005515> <http://purl.obolibrary.org/obo/GO_0005488>)
