        </rdfs:subClassOf>
        <obo:IAO_0000117>Colin Batchelor</obo:IAO_0000117>
        <dcterms:description>An error message produced in the execution of a structural standardiation algorithm.</dcterms:description>
        <rdfs:label xml:lang="en">structural standardization error</rdfs:label>
