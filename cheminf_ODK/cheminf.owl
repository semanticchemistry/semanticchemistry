        <obo:IAO_0000115>Lepton is a fermion that does not experience the strong force (strong interaction). The term is derived from the Greek λεπτοσ (small, thin).</obo:IAO_0000115>
        <rdfs:label>lepton</rdfs:label>
    </owl:Class>
    


