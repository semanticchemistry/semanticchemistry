                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000122"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>A bond length descriptor is a dimensional extent descriptor which gives the measured or predicted (idealised) length of an atom to atom bond within a chemical entity.</dcterms:description>
        <rdfs:label>bond length descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_000133 -->

