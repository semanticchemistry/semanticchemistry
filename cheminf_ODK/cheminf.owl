        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000211"/>
        <dcterms:description>A two dimensional extent is a dimensional extent in two dimensions, e.g. an area.</dcterms:description>
        <rdfs:label>2-D extent</rdfs:label>
    </owl:Class>
    


