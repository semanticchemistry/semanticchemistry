        <dcterms:description>A chemical connectivity table is a structure descriptor which consists of a connection table representing bonds between atoms in a molecular entity.</dcterms:description>
        <rdfs:label>chemical connectivity table</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_000056 -->

