            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>An aromaticity descriptor is a chemical descriptor which indicates the aromaticity of a molecular entity.</dcterms:description>
        <rdfs:label>aromaticity descriptor</rdfs:label>
    </owl:Class>
    


