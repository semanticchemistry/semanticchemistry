    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003674"/>
        <rdfs:label>binding</rdfs:label>
    </owl:Class>
    


