    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001100 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001100">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000065"/>
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/CHEMINF_000143"/>
                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/CHEMINF_000086"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>Descriptor that calculates the sum of the absolute value of the difference between atomic polarizabilities of all bonded atoms in the molecule (including implicit hydrogens).</dcterms:description>
        <rdfs:label>Bond Polarizabilities</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001101 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001101">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>Oxidation state is an atomic descriptor that gives the degree of oxidation of an atom in terms of counting electrons. The higher the oxidation state (OS) of a given atom, the greater is its degree of oxidation. [source: IUPAC Gold Book - https://doi.org/10.1351/goldbook.O04365]</dcterms:description>
        <rdfs:label>oxidation state</rdfs:label>
        <dcmi-terms:source>https://doi.org/10.1351/goldbook.O04365</dcmi-terms:source>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001102 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001102">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000108"/>
        <dcterms:description>As applied to a chemical species, the term expresses a kinetic property. A species is said to be more reactive or to have a higher reactivity in some given context than some other (reference) species if it has a larger rate constant for a specified elementary reaction [source: IUPAC Gold Book - https://doi.org/10.1351/goldbook.R05180]</dcterms:description>
        <rdfs:label>reactivity</rdfs:label>
        <dcmi-terms:source>https://doi.org/10.1351/goldbook.R05180</dcmi-terms:source>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001103 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001103">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_001102"/>
        <dcterms:description>Property by which a chemical species becomes reactive upon exposure to UV or visible light</dcterms:description>
        <rdfs:label>photoreactivity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001104 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001104">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000018"/>
        <dcterms:description>A connectivity SMILES descriptor is a SMILES descriptor that does not include any stereochemical or isotopic information.</dcterms:description>
        <rdfs:label>connectivity SMILES descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001500 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001500">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Eigenvalue based descriptor noted for its utility in chemical diversity.</dcterms:description>
        <bibo:doi> http://dx.doi.org/10.1021/ci980137x</bibo:doi>
        <cheminf:short_name>BCUT</cheminf:short_name>
        <rdfs:label xml:lang="en">BCUT</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001501 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001501">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates bond-pi Partial charge of a bond by determining the difference the Partial Pi Charge on atoms A and B of a bond (based in Gasteiger Charge).</dcterms:description>
        <cheminf:short_name>bondPartialPiCharge</cheminf:short_name>
        <rdfs:label xml:lang="en">bond partial pi charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001502 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001502">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates bond-sigma Partial charge of a bond.</dcterms:description>
        <cheminf:short_name>bondPartialSigmaCharge</cheminf:short_name>
        <rdfs:label xml:lang="en">bond partial sigma charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001503 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001503">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates bond-total Partial charge of a bond.</dcterms:description>
        <cheminf:short_name>bondPartialTCharge</cheminf:short_name>
        <rdfs:label xml:lang="en">bond partial total charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001504 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001504">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates of bond-Polarizability of a bond by determining the difference the Sigma electronegativity on atoms A and B of a bond.</dcterms:description>
        <cheminf:short_name>bondSigmaElectronegativity</cheminf:short_name>
        <rdfs:label xml:lang="en">bond sigma electronegativity</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001505 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001505">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor based on the number of bonds on the shortest path between two atoms (topological distance).</dcterms:description>
        <cheminf:short_name>bondsToAtom</cheminf:short_name>
        <rdfs:comment>This is the shortest distance between a pair of atoms in a graph, defined as the number of edges in the shortest path between the atom pair in the molecular graph.</rdfs:comment>
        <rdfs:label xml:lang="en">bonds to Atom</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001506 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001506">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Evluates the simple and valence chi chain descriptors (Kier and Hall) of orders 3, 4, 5, 6 and 7. </dcterms:description>
        <cheminf:short_name>chiChain</cheminf:short_name>
        <rdfs:comment>It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.</rdfs:comment>
        <rdfs:label xml:lang="en">chi chain indices</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001507 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001507">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Evluates the simple and valence chi cluster descriptors (Kier and Hall) of orders 3, 4,5 and 6.</dcterms:description>
        <cheminf:short_name>chiCluster</cheminf:short_name>
        <rdfs:comment> It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.</rdfs:comment>
        <rdfs:label xml:lang="en">chi cluster indices</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001508 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001508">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Evaluates the Kier and Hall Chi path indices of orders 0,1,2,3,4,5,6 and 7.  </dcterms:description>
        <cheminf:short_name>chiPath</cheminf:short_name>
        <rdfs:comment>It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.</rdfs:comment>
        <rdfs:label xml:lang="en">chi path indices</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001509 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001509">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Evaluates the Kier and Hall Chi path cluster indices of orders 4,5 and 6.</dcterms:description>
        <cheminf:short_name>chiPathCluster</cheminf:short_name>
        <rdfs:comment>It utilizes the graph isomorphism code of the CDK to find fragments matching SMILES strings representing the fragments corresponding to each type of chain.</rdfs:comment>
        <rdfs:label xml:lang="en">chi path-cluster indices</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001510 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001510">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000093"/>
        <dcterms:description>Descriptor characterizing the mass distribution of the molecule.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/jp953224q</bibo:doi>
        <cheminf:short_name>gravitationalIndex</cheminf:short_name>
        <rdfs:label xml:lang="en">gravitational index</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001511 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001511">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_001510"/>
        <dcterms:description>Descriptor characterizing the mass distribution of the molecule as the square or cube root of the gravitational index.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/ci980029a</bibo:doi>
        <cheminf:short_name>gravitationalIndex_SquareAndCubeRoots</cheminf:short_name>
        <rdfs:label xml:lang="en">gravitational index (square and cube roots)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001512 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001512">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Counts the number of acceptor field atoms for a carbonyl oxygen probe using force field based definition.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/jm011039x</bibo:doi>
        <cheminf:short_name>hBondAcceptorsBoehmKlebe</cheminf:short_name>
        <rdfs:label xml:lang="en">acceptor field atoms (Boehm,Klebe)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001513 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001513">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates the number of hydrogen bond acceptors (by Daylight).</dcterms:description>
        <cheminf:short_name>hBondacceptorsDaylight</cheminf:short_name>
        <rdfs:comment>SMILES on-line tutorial, http://www.daylight.com/dayhtml_tutorials/languages/smarts/smarts_examples.html)</rdfs:comment>
        <rdfs:label xml:lang="en">hydrogen bond acceptors (Daylight)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001514 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001514">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Counts the number of acceptor/donor field atoms for a carbonyl oxygen or amino hydrogen probe. </dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/jm011039x</bibo:doi>
        <cheminf:short_name>hBondAcceptorsDonorsBoehmKlebe</cheminf:short_name>
        <rdfs:label xml:lang="en">acceptors or donors field atoms (Boehm,Klebe)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001515 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001515">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Counts the number of donor field atoms for an amino hydrogen probe.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/jm011039x</bibo:doi>
        <cheminf:short_name>hBondDonorsBoehmKlebe</cheminf:short_name>
        <rdfs:label xml:lang="en">donor field atoms (Boehm,Klebe)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001516 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001516">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates the number of hydrogen bond donors (by Daylight).</dcterms:description>
        <cheminf:short_name>hBondDonorsDaylight</cheminf:short_name>
        <rdfs:comment>SMILES on-line tutorial, http://www.daylight.com/dayhtml_tutorials/languages/smarts/smarts_examples.html)</rdfs:comment>
        <rdfs:label xml:lang="en">hydrogen bond donors (Daylight)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001517 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001517">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000136"/>
        <dcterms:description>Descriptor returns 1 if the protons is directly bonded to an aromatic system, it returns 2 if the distance between aromatic system and proton is 2 bonds, and it return 0 for other positions.</dcterms:description>
        <cheminf:short_name>isProtonInAromaticSystem</cheminf:short_name>
        <rdfs:label xml:lang="en">proton belonging to an aromatic system</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001518 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001518">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000136"/>
        <dcterms:description>Descriptor returns true if the protons is directly bonded to a pi system.</dcterms:description>
        <cheminf:short_name>isProtonInConjugatedPiSystem</cheminf:short_name>
        <rdfs:label xml:lang="en">proton belonging to a pi-system</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001519 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001519">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Counts the number of occurrences of the E-state fragments.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.3390/91201004</bibo:doi>
        <cheminf:short_name>kierHallSmarts</cheminf:short_name>
        <rdfs:label xml:lang="en">Kier Hall SMARTS</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001520 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001520">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Evaluate molecular distance edge descriptors for C, N and O.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/ci970109z</bibo:doi>
        <cheminf:short_name>mde</cheminf:short_name>
        <rdfs:label xml:lang="en">molecular distance edge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001521 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001521">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000093"/>
        <dcterms:description>Descriptor that calculates the principal moments of inertia and ratios of the principal moments. Als calculates the radius of gyration.</dcterms:description>
        <cheminf:short_name>momentOfInertia</cheminf:short_name>
        <rdfs:label xml:lang="en">moments of inertia</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001522 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001522">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates total partial charges of an heavy atom.</dcterms:description>
        <cheminf:short_name>partialTChargeMMFF94</cheminf:short_name>
        <rdfs:label xml:lang="en">partial total charge (MMFF94)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001523 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001523">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000136"/>
        <dcterms:description>Descriptor that returns the period in the periodic table of an atom belonging to an atom container.</dcterms:description>
        <cheminf:short_name>period</cheminf:short_name>
        <rdfs:label xml:lang="en">period of an atom</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001524 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001524">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000136"/>
        <dcterms:description>Descriptor that check if two atoms have pi-contact (this is true when there is one and the same conjugated pi-system which contains both atoms, or directly linked neighboors of the atoms).</dcterms:description>
        <cheminf:short_name>piContact</cheminf:short_name>
        <rdfs:label xml:lang="en">pi-contact of two atoms</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001525 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001525">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates partial charges of an heavy atom and its protons based on Gasteiger Marsili (PEOE).</dcterms:description>
        <cheminf:short_name>protonPartialCharge</cheminf:short_name>
        <rdfs:label xml:lang="en">proton total partial charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001526 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001526">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Calculation of RDF proton descriptor.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1021/ac010737m</bibo:doi>
        <cheminf:short_name>rdfProtonCalculatedValues</cheminf:short_name>
        <rdfs:comment>This is a mixed descriptor: topological, geometrical and electronic descriptor.</rdfs:comment>
        <rdfs:label xml:lang="en">RDF proton descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001527 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001527">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptors are derived from pre-calculated quantum mechanical parameters by using the paramaters for amino acids and evaluating a set of 147 descriptors for peptide sequences.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1016/0097-8485(94)00052-G</bibo:doi>
        <cheminf:short_name>taeAminoAcid</cheminf:short_name>
        <rdfs:comment>{@cdk.cite BREN1995} {@cdk.cite BREN1997} {@cdk.cite WHITE2003}</rdfs:comment>
        <rdfs:label xml:lang="en">TAE RECON descriptors for amino acid sequences</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001528 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001528">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>The weighted path (molecular ID) descriptors were described by Randic and they characterize molecular branching.</dcterms:description>
        <cheminf:short_name>weightedPath</cheminf:short_name>
        <rdfs:label xml:lang="en">weighted path</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001529 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001529">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Holistic descriptors described by Todeschini et al.</dcterms:description>
        <cheminf:short_name>WHIM</cheminf:short_name>
        <rdfs:comment>Todeschini, R. and Gramatica, P.. New 3D Molecular Descriptors: The WHIM theory and QAR Applications, Persepectives in Drug Discovery and Design. 1998, pp. 355-380. Mixed descriptors: molecular size, shape, symmetry, and atom distribution and density. Uses 3D coordinates, PCA and it calculates 10 descriptors.</rdfs:comment>
        <rdfs:label xml:lang="en">WHIM</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001530 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001530">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>The Moreau-Broto autocorrelation descriptors using partial charges.</dcterms:description>
        <cheminf:short_name>autoCorrelationCharge</cheminf:short_name>
        <rdfs:comment>ATSc1 - ATSc5</rdfs:comment>
        <rdfs:label xml:lang="en">Moreau-Broto Autocorrelation (charge) descriptors</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001531 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001531">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>The Moreau-Broto autocorrelation descriptors using atomic weight.</dcterms:description>
        <cheminf:short_name>autoCorrelationMass</cheminf:short_name>
        <rdfs:comment>ATSm1 - ATSm5</rdfs:comment>
        <rdfs:label xml:lang="en">Moreau-Broto autocorrelation (mass) descriptors</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001532 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001532">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>The Moreau-Broto autocorrelation descriptors using polarizability.</dcterms:description>
        <cheminf:short_name>autoCorrelationPolarizability</cheminf:short_name>
        <rdfs:comment>ATSp1 - ATSp5</rdfs:comment>
        <rdfs:label xml:lang="en">Moreau-Broto autocorrelation (polarizability) descriptors</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001533 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001533">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Characterizes the carbon connectivity in terms of hybridization</dcterms:description>
        <cheminf:short_name>carbonTypes</cheminf:short_name>
        <rdfs:comment>C1SP1, C2SP1, C1SP2, C2SP2, C3SP2, C1SP3, C2SP3, C3SP3, C4SP3</rdfs:comment>
        <rdfs:label xml:lang="en">carbon types</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001534 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001534">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates the carbon connectivity index (order 0). </dcterms:description>
        <cheminf:short_name>chi0C</cheminf:short_name>
        <rdfs:label xml:lang="en">carbon connectivity index (order 0)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001535 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001535">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates atomic valence connectivity index (order 0). </dcterms:description>
        <cheminf:short_name>chi0v</cheminf:short_name>
        <rdfs:label xml:lang="en">valence connectivity index (order 0)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001536 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001536">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates carbon valence connectivity index (order 0).</dcterms:description>
        <cheminf:short_name>chi0vC</cheminf:short_name>
        <rdfs:label xml:lang="en">valence carbon connectivity index (order 0)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001537 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001537">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates carbon connectivity index (order 1). </dcterms:description>
        <cheminf:short_name>chi1C</cheminf:short_name>
        <rdfs:label xml:lang="en">carbon connectivity index (order 1)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001538 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001538">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates atomic valence connectivity index (order 1). </dcterms:description>
        <cheminf:short_name>chi1v</cheminf:short_name>
        <rdfs:label xml:lang="en">valence connectivity index (order 1)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001539 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001539">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates carbon valence connectivity index (order 1). </dcterms:description>
        <cheminf:short_name>chi1vC</cheminf:short_name>
        <rdfs:label xml:lang="en">valence carbon connectivity index (order 1)</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001540 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001540">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000093"/>
        <dcterms:description>Descriptor that calculates the 3D distance between two atoms.</dcterms:description>
        <cheminf:short_name>distanceToAtom</cheminf:short_name>
        <rdfs:label xml:lang="en">distance to atom</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001541 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001541">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates the effective polarizability of a given heavy atom.</dcterms:description>
        <cheminf:short_name>effectivePolarizability</cheminf:short_name>
        <rdfs:comment>EffectiveAtomPolarizabilityDescriptor, effAtomPol</rdfs:comment>
        <rdfs:label xml:lang="en">effective polarizability</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001542 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001542">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Characterizes molecular complexity in terms of carbon hybridization states.</dcterms:description>
        <cheminf:short_name>hybratio</cheminf:short_name>
        <rdfs:comment>It reports the fraction of sp3 carbons to sp2 carbons as Nsp3/ (Nsp3 + Nsp2). The original form of the descriptor (i.e., simple ratio) has been used to characterize molecular complexity, especially in the are of natural products , which usually have a high value of the sp3 to sp2 ratio. Other short names: HybridizationRatio, HybRatio.</rdfs:comment>
        <rdfs:label xml:lang="en">hybridization ratio</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001543 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001543">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000092"/>
        <dcterms:description>Descriptor that calculates Kier and Hall kappa molecular shape indices.</dcterms:description>
        <cheminf:short_name>kierValues</cheminf:short_name>
        <rdfs:comment>Kier and Hall kappa molecular shape indices compare the molecular graph with minimal and maximal molecular graphs. First kappa shape index is given by n ( n - 1 ) 2 m 2 , second kappa shape index is given by ( n - 1 ) ( n - 2 ) 2 p 2 2 and third kappa shape index is given by ( n - 1 ) ( n - 3 ) 2 p 3 2 for odd n and ( n - 3 ) ( n - 2 ) 2 p 3 2 for enev n, where n denotes the number of atoms in the hydrogen suppressed graph, m is the number of bonds in the hydrogen suppressed graph. Also, let p2 denote the number of paths of length 2 and let p3 denote the number of paths of length 3. Other short names: KappaShapeIndices, Kier1, Kier2, Kier3.</rdfs:comment>
        <rdfs:label xml:lang="en">Kier and Hall kappa molecular shape indices</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001544 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001544">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates pi partial charges in pi-bonded systems of an heavy atom based on based on Gasteiger H.Saller (PEPE).</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1002/ange.19850970818</bibo:doi>
        <cheminf:short_name>partialPiCharge</cheminf:short_name>
        <rdfs:comment>Other short_name: pepe.</rdfs:comment>
        <rdfs:label xml:lang="en">partial pi charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001545 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001545">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that calculates sigma partial charges in sigma-bonded systems (PEOE) of an heavy atom based on Gasteiger Marsili.</dcterms:description>
        <bibo:doi>http://dx.doi.org/10.1016/0040-4020(80)80168-2</bibo:doi>
        <cheminf:short_name>partialSigmaCharge</cheminf:short_name>
        <rdfs:label xml:lang="en">partial sigma charge</rdfs:label>
    </owl:Class>
    


    <!-- http://semanticscience.org/resource/CHEMINF_001546 -->

    <owl:Class rdf:about="http://semanticscience.org/resource/CHEMINF_001546">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000087"/>
        <dcterms:description>Descriptor that returns the pi electronegativity for a given atom.</dcterms:description>
        <cheminf:short_name>piElectronegativity</cheminf:short_name>
        <rdfs:comment>Pi electronegativity is given by X = a + b q + c ( q 2 ) , where a, b and c are Gasteiger Marsili parameters, and q is the sigma charge. Other short_name: elecPiA.</rdfs:comment>
        <rdfs:label xml:lang="en">pi electronegativity</rdfs:label>
    </owl:Class>
    


