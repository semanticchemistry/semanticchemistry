            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>A descriptor that specifies the integer count of atoms in a given molecular entity.</dcterms:description>
        <rdfs:label>atom count</rdfs:label>
    </owl:Class>
    


