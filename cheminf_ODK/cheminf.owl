    <owl:Ontology rdf:about="http://semanticscience.org/ontology/cheminf.owl">
        <owl:versionIRI rdf:resource="http://semanticscience.org/ontology/cheminf/releases/2026-09-18/cheminf.owl"/>
        <dce:contributor>Gang Fu</dce:contributor>
        <dce:format>application/rdf+xml</dce:format>
        <dce:language>en</dce:language>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-5985-7429"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6966-0814"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-7010-3812"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-7542-0286"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-3469-4923"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-4166-7093"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-5628-2268"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-5959-6190"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-8011-0300"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-3136-1338"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0003-4727-9435"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0001-5998-5030"/>
        <dcterms:description>The chemical information ontology (cheminf) describes information entities about chemical entities. It provides qualitative and quantitative attributes to richly describe chemicals. Includes terms for the descriptors commonly used in cheminformatics software applications and the algorithms which generate them.</dcterms:description>
        <dcterms:license rdf:resource="http://creativecommons.org/publicdomain/zero/1.0/"/>
        <dcterms:title>chemical information ontology (cheminf) - information entities about chemical entities</dcterms:title>
        <owl:versionInfo>2026-09-18</owl:versionInfo>
        <owl:versionInfo>v26-11-2025_ODK_alpha</owl:versionInfo>
    </owl:Ontology>
    


