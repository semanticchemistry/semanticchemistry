                <owl:someValuesFrom rdf:resource="http://semanticscience.org/resource/CHEMINF_000235"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:description>Bond dissociation entropy descriptor captures the entropy associated with the process of breaking the bond in question. This could be measured or calculated in vacuo or in a specific Solvent, at a given temperature and pressure. Depends on molecular conformation.</dcterms:description>
        <rdfs:label>bond dissociation entropy descriptor</rdfs:label>
    </owl:Class>
    


