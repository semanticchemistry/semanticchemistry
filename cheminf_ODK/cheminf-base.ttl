###  http://semanticscience.org/resource/CHEMINF_000067
resource:CHEMINF_000067 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "cyclicity is a quality that inheres in a molecular entity by virtue of the presence of cycles in the connection of the atoms within the molecular entity." ;
                        rdfs:label "cyclicity" .


###  http://semanticscience.org/resource/CHEMINF_000068
resource:CHEMINF_000068 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000085 ;
                        dcterms:description "A functional group descriptor is a structural descriptor which describes specific groups of atoms within molecules that are responsible for the characteristic chemical reactions of those molecules." ;
                        rdfs:label "functional group descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000069
resource:CHEMINF_000069 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Polarity is a quality that inheres in a molecular entity by virtue of whether or not the molecular entity has a separation of electric charge which leads to the molecule having an electric dipole." ;
                        rdfs:label "polarity" .


###  http://semanticscience.org/resource/CHEMINF_000070
resource:CHEMINF_000070 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000069 ;
                        owl:disjointWith resource:CHEMINF_000071 ;
                        dcterms:description "Polar polarity is a quality that inheres in a molecular entity when the molecular entity is polar, i.e. does possess an electric dipole." ;
                        rdfs:label "polar" .


###  http://semanticscience.org/resource/CHEMINF_000071
resource:CHEMINF_000071 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000069 ;
                        dcterms:description "Nonpolar polarity is a quality which inheres in a molecular entity when the molecular entity does not possess an electrical dipole." ;
                        rdfs:label "nonpolar" .


###  http://semanticscience.org/resource/CHEMINF_000072
resource:CHEMINF_000072 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000067 ;
                        owl:disjointWith resource:CHEMINF_000073 ;
                        dcterms:description "Cyclic cyclicity inheres in a molecule when the atoms of the molecule do contain at least one cycle in the atom-atom connection paths (through bonds)." ;
                        rdfs:label "cyclic" .


###  http://semanticscience.org/resource/CHEMINF_000073
resource:CHEMINF_000073 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000067 ;
                        dcterms:description "Acyclic cyclicity inheres in a molecule when the atoms within the molecule do not contain at least one cycle in the atom-atom connection paths (through the bonds)." ;
                        rdfs:label "acyclic" .


###  http://semanticscience.org/resource/CHEMINF_000074
resource:CHEMINF_000074 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000013 ;
                        owl:disjointWith resource:CHEMINF_000075 ;
                        rdfs:label "chiral" .


###  http://semanticscience.org/resource/CHEMINF_000075
resource:CHEMINF_000075 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000013 ;
                        rdfs:label "achiral" .


###  http://semanticscience.org/resource/CHEMINF_000076
resource:CHEMINF_000076 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000115 ;
                        owl:disjointWith resource:CHEMINF_000077 ;
                        dcterms:description "Aromatic aromaticity is a quality that inheres in a molecular entity when it possesses at least one ring that is aromatic." ;
                        rdfs:label "aromatic" .


###  http://semanticscience.org/resource/CHEMINF_000077
resource:CHEMINF_000077 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000115 ;
                        dcterms:description "Non aromatic aromaticity is a quality that inheres in a molecular entity by virtue of the molecule possessing no rings that are aromatic." ;
                        rdfs:label "non-aromatic" .


