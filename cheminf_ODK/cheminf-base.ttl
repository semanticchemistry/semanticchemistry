###  http://semanticscience.org/resource/CHEMINF_000115
resource:CHEMINF_000115 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Aromaticity is a molecular entity quality that inheres in a conjugated ring of unsaturated bonds, lone pairs, or empty orbitals that exhibit a stabilization stronger than would be expected by the stabilization of conjugation alone." ;
                        rdfs:label "aromaticity" .


###  http://semanticscience.org/resource/CHEMINF_000116
resource:CHEMINF_000116 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000093 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "An atomic connectivity index is an atomic descriptor that is a measure of atomic connectivity, which can take various forms (e.g. zero-order, or first-order)." ;
                        rdfs:label "atomic connectivity index" .


###  http://semanticscience.org/resource/CHEMINF_000117
resource:CHEMINF_000117 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000092 ;
                        dcterms:description "Half the sum of all the distance matrix entries, topological index of atom-atom distances." ;
                        rdfs:label "Wiener path number" .


###  http://semanticscience.org/resource/CHEMINF_000118
resource:CHEMINF_000118 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000131 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description """The formal charge gives the charge assigned to an atom in a molecule, assuming that electrons in a chemical bond are shared equally between atoms, regardless of relative electronegativity.
The formal charge of any atom in a molecule can be calculated by the following equation: FC = number of valence electrons of the atom in isolation (atom in ground state) - number of non-bonding electrons on this atom in the molecule - half the total number of electrons shared in covalent bonds with other atoms in the molecule. [source:wikipedia]""" ;
                        rdfs:label "formal charge descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000119
resource:CHEMINF_000119 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000131 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "A partial charge descriptor gives the charge with an absolute value of less than one elementary charge unit (that is, smaller than the charge of the electron). [source:wikipedia]" ;
                        rdfs:label "partial charge descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000120
resource:CHEMINF_000120 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Charge is a quality that inheres in a molecular entity by virtue of the overall electric charge of the molecule, which is due to a comparison between the total number of electrons and the total number of protons." ;
                        rdfs:label "charge" .


###  http://semanticscience.org/resource/CHEMINF_000121
resource:CHEMINF_000121 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "Electronegativity is an atomic quality that describes its power to attract electrons to itself [source:IUPAC Gold Book - http://goldbook.iupac.org/E01990.html]" ;
                        rdfs:label "electronegativity" .


