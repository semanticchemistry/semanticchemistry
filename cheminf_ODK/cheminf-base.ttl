###  http://semanticscience.org/resource/CHEMINF_000400
resource:CHEMINF_000400 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000085 ;
                        dcterms:description "A chemical graph is a structural descriptor in which the connectivity and constitution of the chemical entity are described in terms of a mathematical graph, usually with atoms as vertices and bonds as edges, but other variants exist." ;
                        rdfs:label "chemical graph" .


###  http://semanticscience.org/resource/CHEMINF_000401
resource:CHEMINF_000401 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000120 ;
                        dcterms:description "Neutral charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing the same amount of electrons overall as protons, thus having an overall neutral charge." ;
                        rdfs:label "neutral charge" .


###  http://semanticscience.org/resource/CHEMINF_000402
resource:CHEMINF_000402 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000120 ;
                        dcterms:description "Positive charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more protons overall than electrons, thus having an overall positive charge." ;
                        rdfs:label "positive charge" .


###  http://semanticscience.org/resource/CHEMINF_000403
resource:CHEMINF_000403 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000120 ;
                        dcterms:description "Negative charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more electrons overall than protons, thus having an overall negative charge." ;
                        rdfs:label "negative charge" .


###  http://semanticscience.org/resource/CHEMINF_000404
resource:CHEMINF_000404 rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000016 ;
                        dcterms:description "A chemical disposition is a disposition which inheres in a chemical entity." ;
                        rdfs:label "chemical disposition" .


