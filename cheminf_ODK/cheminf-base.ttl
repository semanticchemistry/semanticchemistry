                                        resource:CHEMINF_000083 ;
                        obo:IAO_0000115 "The mass of a molecule calculated according to some assumption about the isotopic identity of the atoms constituting it." ;
                        obo:IAO_0000117 "Person: Colin Batchelor" ;
                        rdfs:label "molecular mass descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000089
resource:CHEMINF_000089 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "The ease of distortion of the electron cloud of a molecular entity by an electric field [source: IUPAC Gold Book - http://goldbook.iupac.org/P04711.html]" ;
                        rdfs:label "polarizability" .


###  http://semanticscience.org/resource/CHEMINF_000090
resource:CHEMINF_000090 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000209 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "The integer number of non-H substituents of an atom." ;
                        rdfs:label "atomic degree" .


###  http://semanticscience.org/resource/CHEMINF_000091
resource:CHEMINF_000091 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "The quality of an atom that reflects the combination of its atomic orbitals to create bonding orbitals." ;
                        rdfs:label "hybridization" .


###  http://semanticscience.org/resource/CHEMINF_000092
resource:CHEMINF_000092 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A topological descriptor is a chemical descriptor which pertains to spatial properties of a geometric object that are preserved under continuous deformations of objects, for example, deformations that involve stretching." ;
                        rdfs:label "topological descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000093
resource:CHEMINF_000093 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A geometric descriptor is a descriptor that concerns information about size, shape, and relative position." ;
                        rdfs:label "geometric descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000094
resource:CHEMINF_000094 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000087 ;
                        rdfs:label "charge delocalization descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000095
resource:CHEMINF_000095 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000087 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000091
                                        ] ;
                        dcterms:description "A hybridization descriptor is a chemical descriptor that is about the hybridization of atomic orbitals in a molecular entity." ;
                        rdfs:label "hybridization descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000096
resource:CHEMINF_000096 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000087 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "Atomic valence is an atomic descriptor that specifies the maximum number of univalent atoms (originally hydrogen or chlorine atoms) which may combine with an atom of the element under consideration, or with a fragment, or for which an atom of this element can be substituted [source: IUPAC Gold Book - http://goldbook.iupac.org/V06588.html]" ;
                        rdfs:label "atomic valence" .


###  http://semanticscience.org/resource/CHEMINF_000097
resource:CHEMINF_000097 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000094 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "An atomic hardness descriptor is an atomic descriptor that estimates the difference between the ionization potential and the electron affinity of a given atom." ;
                        rdfs:label "atomic hardness descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000098
resource:CHEMINF_000098 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Valency is an atomic quality of the number of chemical bonds formed by the atom." ;
                        rdfs:label "valency" .


###  http://semanticscience.org/resource/CHEMINF_000099
resource:CHEMINF_000099 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000094 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "An atomic softness descriptor is an atomic descriptor which is about the charge delocalizing ability of a given atom." ;
                        rdfs:label "atomic softness descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000100
resource:CHEMINF_000100 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000035 ;
                        dcterms:description "The MOLfile atomic connectivity molecular structure encoding format specification may be found described at http://en.wikipedia.org/wiki/Chemical_table_file#Molfiles. It is composed primarily of a connection table (atoms and bonds); hydrogen may be implicit or explicit." ;
                        rdfs:label "MOLfile format specification" .


###  http://semanticscience.org/resource/CHEMINF_000101
resource:CHEMINF_000101 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000086 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:RO_0000052 ;
                                          owl:someValuesFrom resource:CHEMINF_000266
                                        ] ;
                        dcterms:description "A chemical substance quality is a quality that inheres in an aggregate molecular substance, such as a portion of solid or liquid matter." ;
                        rdfs:label "chemical substance quality" .


###  http://semanticscience.org/resource/CHEMINF_000102
resource:CHEMINF_000102 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000101 ;
                        dcterms:description "A crystal structure is a chemical substance quality which inheres in a crystalline solid or liquid crystal substance by virtue of the way the molecules are ordered within the crystal." ;
                        rdfs:label "crystal structure" .


###  http://semanticscience.org/resource/CHEMINF_000103
resource:CHEMINF_000103 rdf:type owl:Class ;
                        rdfs:subClassOf obo:IAO_0000064 ,
                                        resource:CHEMINF_000340 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000047 ;
                                          owl:someValuesFrom resource:CHEMINF_000144
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000331 ;
                                          owl:someValuesFrom resource:CHEMINF_000123
                                        ] ;
                        dcterms:description "A software module to calculate a chemical descriptor is software module that implements an algorithm which calculates a descriptor value for a chemical entity." ;
                        rdfs:label "software module to calculate a chemical descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000104
resource:CHEMINF_000104 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000064 ,
                                        resource:CHEMINF_000065 ;
                        dcterms:description "A molecular QSAR descriptor is a OSAR descriptor which gives a quantitative value to some aspect of a molecular entity." ;
                        rdfs:label "molecular QSAR descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000105
resource:CHEMINF_000105 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000085 ;
                        dcterms:description "The cycle basis of a molecular structure is the smallest set of cycles (closed paths) formed in the graph representation of the structure, from which all other cycles can be computed." ;
                        rdfs:label "cycle basis" .


###  http://semanticscience.org/resource/CHEMINF_000106
resource:CHEMINF_000106 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000043 ;
                        dcterms:description "A systematic name is a molecular entity name which is formulated systematically from the structure of the molecular entity." ;
                        rdfs:label "systematic name" .


###  http://semanticscience.org/resource/CHEMINF_000107
resource:CHEMINF_000107 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000106 ;
                        dcterms:description "An IUPAC name is a systematic name which is formulated according to the rules and recommendations for chemical nomenclature set out by the International Union of Pure and Applied Chemistry (IUPAC)." ;
                        rdfs:label "IUPAC name" .


###  http://semanticscience.org/resource/CHEMINF_000108
resource:CHEMINF_000108 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:RO_0000052 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ;
                        dcterms:description "An atomic quality is a molecular entity quality which inheres in an atom." ;
                        rdfs:label "atomic quality" .


###  http://semanticscience.org/resource/CHEMINF_000109
resource:CHEMINF_000109 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000043 ;
                        dcterms:description "A trivial name is a molecular entity name that is in common public use and may not be related to the structure of the molecular entity." ;
                        rdfs:label "trivial name" .


###  http://semanticscience.org/resource/CHEMINF_000110
resource:CHEMINF_000110 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000085 ;
                        dcterms:description "The fused cycles in a molecular structure are those cycles from the cycle basis which share at least one bond." ;
                        rdfs:label "fused cycles" .


###  http://semanticscience.org/resource/CHEMINF_000111
resource:CHEMINF_000111 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000035 ;
                        dcterms:description "A CML (Chemical Markup Language) file is an XML-based representation of the atomic connectivity of a molecular entity." ;
                        rdfs:label "CML format specification" .


###  http://semanticscience.org/resource/CHEMINF_000112
resource:CHEMINF_000112 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000064 ,
                                        resource:CHEMINF_000065 ;
                        dcterms:description "An atomic QSAR descriptor is a QSAR descriptor which gives a quantitative value to some aspect of an atom which is part of a molecular entity." ;
                        rdfs:label "atomic QSAR descriptor" .


