resource:CHEMINF_000006 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000005 ;
                        owl:disjointWith resource:CHEMINF_000034 ;
                        rdfs:label "R stereochemical descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000007
resource:CHEMINF_000007 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000018 ;
                        dcterms:description "A canonical SMILES descriptor is a SMILES descriptor that is produced using a canonicalization algorithm which results in one special generic SMILES among all valid possibilities." ;
                        rdfs:label "canonical SMILES descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000008
resource:CHEMINF_000008 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000229 ;
                        dcterms:description "charge weighted partial positive surface area" ;
                        cheminf-core:short_name "PPSA-3" ;
                        rdfs:label "charge weighted partial positive surface area" .


###  http://semanticscience.org/resource/CHEMINF_000010
resource:CHEMINF_000010 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000041 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom obo:CHEBI_33250
                                        ] ,
                                        [ rdf:type owl:Restriction ;
