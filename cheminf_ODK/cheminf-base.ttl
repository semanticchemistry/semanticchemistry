resource:CHEMINF_000085 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A structural descriptor is a chemical descriptor which is about some aspect of the molecular structure (composition) of a chemical entity." ;
                        rdfs:label "structural descriptor" .


