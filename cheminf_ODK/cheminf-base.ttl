                        rdfs:subClassOf resource:CHEMINF_000209 ;
                        obo:IAO_0000115 """The number of structural alerts, that is, unwanted features as defined according to the procedure followed in Brenk et al., 2008.
Brenk R, et al. Lessons learnt from assembling screening libraries for drug discovery for neglected diseases. Chem Med Chem. 2008;3:435–444. """ ;
                        rdfs:label "structural alert count"@en .


###  http://semanticscience.org/resource/CHEMINF_000431
resource:CHEMINF_000431 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000115 """A descriptor which gives a quantitative estimate of drug likeness according to the procedure outlined in Bickerton et al., 2012.

http://www.ncbi.nlm.nih.gov/pubmed/22270643
Nat Chem. 2012 Jan 24;4(2):90-8. doi: 10.1038/nchem.1243.
Quantifying the chemical beauty of drugs.
Bickerton GR, Paolini GV, Besnard J, Muresan S, Hopkins AL.""" ;
                        obo:IAO_0000118 "QED weighted" ;
                        rdfs:label "weighted quantitative estimate of drug-likeness"@en .


###  http://semanticscience.org/resource/CHEMINF_000432
resource:CHEMINF_000432 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A descriptor that indicates the temperature at which a chemical substance undergoes a state transition from gas or liquid to solid, under standard conditions." ;
                        rdfs:label "freezing point descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000433
resource:CHEMINF_000433 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description """Henry's law, formulated by William Henry in 1803, states \"At a constant temperature, the amount of a given gas that dissolves in a given type and volume of liquid is directly proportional to the partial pressure of that gas in equilibrium with that liquid.\" Henry's law can be put into mathematical terms (at constant temperature) as
    p = kHc
where p is the partial pressure of the solute in the gas above the solution, c is the concentration of the solute and kH is a constant with the dimensions of pressure divided by concentration. The constant, known as the Henry's law constant, depends on the solute, the solvent and the temperature.""" ;
                        rdfs:label "Henry's Law constant"@en .


###  http://semanticscience.org/resource/CHEMINF_000434
resource:CHEMINF_000434 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor for the rate constant of a reaction of a chemical entity with OH. This is used to describe the atmospheric behaviour (i.e. stability) of the entity. " ;
                        rdfs:label "atmospheric OH rate constant"@en .


###  http://semanticscience.org/resource/CHEMINF_000435
resource:CHEMINF_000435 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor for the upper explosive limit of the entity in air as a percentage by volume at room temperature. " ;
                        rdfs:label "upper explosive limit descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000436
resource:CHEMINF_000436 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor for the lower explosive limit in air as a percentage by volume at room temperature" ;
                        rdfs:label "lower explosive limit descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000437
resource:CHEMINF_000437 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor for the minimum explosive concentration. " ;
                        rdfs:label "minimum explosive concentration descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000438
resource:CHEMINF_000438 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor of the ratio of the density of chemical substance to the density of a reference substance. The reference substance is usually water for liquids or air for gases. " ;
                        rdfs:label "specific gravity descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000439
resource:CHEMINF_000439 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A descriptor of the relative density of gases referenced to air as 1, which indicates how many times a gas is heavier than air at the same temperature. " ;
                        rdfs:label "relative density descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000440
resource:CHEMINF_000440 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A descriptor of the density of a vapour in relation in that of hydrogen, defined as the mass of a certain volume of the given substance divided by the mass of the same volume of hydrogen. " ;
                        rdfs:label "vapor density descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000441
resource:CHEMINF_000441 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor for the lowest concentration of an odorant chemical entity that is perceivable by the human sense of smell. " ;
                        rdfs:label "odor detection threshold descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000442
resource:CHEMINF_000442 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        dcterms:description "A physical descriptor which gives a measure of the acidity or basicity of an aqueous solution, defined as the decimal logarithm of the reciprocal of the hydrogen ion activity in a solution. " ;
                        rdfs:label "pH descriptor"@en .


