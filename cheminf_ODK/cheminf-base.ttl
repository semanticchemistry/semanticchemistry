                                          owl:someValuesFrom resource:CHEMINF_000115
                                        ] ;
                        dcterms:description "An aromaticity descriptor is a chemical descriptor which indicates the aromaticity of a molecular entity." ;
                        rdfs:label "aromaticity descriptor" .


