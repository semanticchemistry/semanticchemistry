                                                                owl:versionIRI <http://semanticscience.org/ontology/cheminf/releases/2026-09-18/cheminf-base.ttl> ;
                                                                dce:contributor "Gang Fu" ;
                                                                dce:format "application/rdf+xml" ;
                                                                dce:language "en" ;
                                                                dce:type obo:IAO_8000001 ;
                                                                dcterms:contributor <https://orcid.org/0000-0001-5985-7429> ,
                                                                                    <https://orcid.org/0000-0001-6966-0814> ,
                                                                                    <https://orcid.org/0000-0001-7010-3812> ,
                                                                                    <https://orcid.org/0000-0001-7542-0286> ,
                                                                                    <https://orcid.org/0000-0002-1595-3213> ,
                                                                                    <https://orcid.org/0000-0002-3469-4923> ,
                                                                                    <https://orcid.org/0000-0002-4166-7093> ,
                                                                                    <https://orcid.org/0000-0002-5628-2268> ,
                                                                                    <https://orcid.org/0000-0002-5959-6190> ,
                                                                                    <https://orcid.org/0000-0002-8011-0300> ,
                                                                                    <https://orcid.org/0000-0003-3136-1338> ,
                                                                                    <https://orcid.org/0000-0003-4727-9435> ,
                                                                                    <https://orcid.org/0009-0001-5998-5030> ;
                                                                dcterms:description "The chemical information ontology (cheminf) describes information entities about chemical entities. It provides qualitative and quantitative attributes to richly describe chemicals. Includes terms for the descriptors commonly used in cheminformatics software applications and the algorithms which generate them." ;
                                                                dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
                                                                dcterms:title "chemical information ontology (cheminf) - information entities about chemical entities" ;
                                                                owl:versionInfo "2026-09-18" ,
                                                                                "v26-11-2025_ODK_alpha" .

