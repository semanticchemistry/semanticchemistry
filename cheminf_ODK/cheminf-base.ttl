                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "The largest chain size descriptor is a count descriptor that gives the integer length (number of atoms) in the largest chain in a molecular entity." ;
