                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "A descriptor that specifies the integer count of bonds in a given molecular entity." ;
                        rdfs:label "bond count" .


###  http://semanticscience.org/resource/CHEMINF_000234
