###  http://semanticscience.org/resource/CHEMINF_000000
resource:CHEMINF_000000 rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000040 ;
                        dcterms:description "A chemical entity is any molecular entity or chemical substance." ;
                        oboInOwl:hasAlternativeId "CHEBI:24431" ,
                                                  "obo:24431" ;
                        rdfs:label "chemical entity" .


###  http://semanticscience.org/resource/CHEMINF_000001
resource:CHEMINF_000001 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000094 ;
                        dcterms:description "Molar refractviity is a measure of the total polarizability of a mole of a substance and is dependent on the temperature, the index of refraction, and the pressure." ;
                        rdfs:label "molar refractivity" .


###  http://semanticscience.org/resource/CHEMINF_000002
resource:CHEMINF_000002 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000094 ;
                        dcterms:description "atomic polarizability sum is the sum of the atomic polarizabilities (including implicit hydrogens)." ;
                        rdfs:label "atomic polarizability sum" .


###  http://semanticscience.org/resource/CHEMINF_000003
resource:CHEMINF_000003 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000229 ;
                        dcterms:description "sum of surface area on positive parts of molecule" ;
                        cheminf-core:short_name "PPSA-1" ;
                        rdfs:label "partial positive surface area" .


###  http://semanticscience.org/resource/CHEMINF_000004
resource:CHEMINF_000004 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000229 ;
                        dcterms:description "partial positive surface area * total positive charge on the molecule" ;
                        cheminf-core:short_name "PPSA-2" ;
                        rdfs:label "PPSA-2" .


