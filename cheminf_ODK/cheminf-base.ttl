resource:CHEMINF_000183 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000185 ;
                        dcterms:description "A measure of the anisotropy in a molecule (as per Bath et al)" ;
                        rdfs:label "Petitjean Geometric Shape Index"@en .


###  http://semanticscience.org/resource/CHEMINF_000184
resource:CHEMINF_000184 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000092 ;
                        dcterms:description "the eccentricity of a vertex corresponds to the distance from that vertex to the most remote vertex in the graph. The distance is obtained from the distance matrix as the count of edges between the two vertices. If r i is the largest matrix entry in row i of the distance matrix D, then the radius is defined as the smallest of the r i . The graph diameter D is defined as the largest vertex eccentricity in the graph. Petitjean Number is the value of ( diameter - radius ) diameter ." ;
                        cheminf-core:short_name "petitjeanNumber" ;
                        rdfs:label "Petitjean number"@en .


###  http://semanticscience.org/resource/CHEMINF_000185
resource:CHEMINF_000185 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000092 ;
                        dcterms:description "A measure of the anisotropy in a molecule" ;
                        cheminf-core:short_name "petitjeanShapeIndex" ;
                        rdfs:label "Petitjean Shape Index"@en .


###  http://semanticscience.org/resource/CHEMINF_000186
resource:CHEMINF_000186 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000251 ;
                        dcterms:description "A LogP descriptor based on the atom-type method described in Wang, R., Fu, Y., and Lai, L.. A New Atom-Additive Method for Calculating Partition Coefficients, Journal of Chemical Information and Computer Sciences. vol. 37. 1997, pp. 615-621." ;
                        cheminf-core:short_name "XLogP" ;
                        rdfs:label "XLogP descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000187
resource:CHEMINF_000187 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000251 ;
                        dcterms:description "A LogP descriptor based on a simple equation using the number of carbons and hetero atoms." ;
                        cheminf-core:short_name "MannholdLogP" ;
                        rdfs:label "MLogP descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000188
resource:CHEMINF_000188 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000189 ;
                        rdfs:label "maximal ratio of length to breadth descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000189
resource:CHEMINF_000189 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000093 ;
                        obo:IAO_0000115 "A descriptor characterizing the ratio of the length to the breadth of a given entity." ;
                        rdfs:label "ratio of length to breadth descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000190
resource:CHEMINF_000190 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000189 ;
                        rdfs:label "minimal ratio of length to breadth descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000191
resource:CHEMINF_000191 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000094 ;
                        obo:IAO_0000115 """An ionization energy descriptor is a descriptor that describes the minimum amount of energy required to remove an electron (to an infinite distance) from an atom or molecule in a gaseous state.

X + energy → X+ + e-

The term 'ionization potential' has historically been used but is now no longer recommended. """ ;
                        obo:IAO_0000118 "ionization energy" ,
                                        "ionization enthalpy" ,
                                        "ionization potential" ;
                        rdfs:label "ionization energy descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000192
resource:CHEMINF_000192 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000092 ;
                        cheminf-core:short_name "EccentricConnectivityIndex" ;
                        rdfs:label "eccentric connectivity index descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000193
resource:CHEMINF_000193 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000087 ;
                        rdfs:label "equilibrium constant"@en .


###  http://semanticscience.org/resource/CHEMINF_000194
resource:CHEMINF_000194 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000193 ;
                        dcterms:description "the acid dissociation constant, Ka, is quantitative measure of the strength of an acid in solution. It is the equilibrium constant for a chemical reaction known as dissociation in the context of acid-base reactions." ;
                        cheminf-core:short_name "Ka" ;
                        rdfs:label "acid dissociation constant"@en .


###  http://semanticscience.org/resource/CHEMINF_000195
resource:CHEMINF_000195 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000193 ;
                        dcterms:description "the logarithmic measure of the acid dissociation constant (Ka)" ;
                        cheminf-core:short_name "pKa" ;
                        rdfs:label "pKa"@en .


###  http://semanticscience.org/resource/CHEMINF_000196
resource:CHEMINF_000196 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000197 ;
                        dcterms:description "A cycle is a part of a molecular entity that is cyclic, that is, consists of a chain of atoms where each is reachable by a bond connected to another atom, and the first atom is reachable from itself." ;
                        rdfs:label "cycle" .


###  http://semanticscience.org/resource/CHEMINF_000197
