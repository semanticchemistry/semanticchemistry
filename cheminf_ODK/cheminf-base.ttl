                                        ] ;
                        dcterms:description "Atomic order is an atomic descriptor that specifies the ordinal position of an atom." ;
                        rdfs:label "atomic order" .


###  http://semanticscience.org/resource/CHEMINF_000011
resource:CHEMINF_000011 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000229 ;
                        dcterms:description "sum of surface area on negative parts of molecule" ;
                        cheminf-core:short_name "PNSA-1" ;
                        rdfs:label "partial negative surface area" .


###  http://semanticscience.org/resource/CHEMINF_000013
resource:CHEMINF_000013 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Chirality is a molecular entity quality which inheres in a molecular entity by virtue of the existence of another molecular entity which is the  mirror image of the first one, yet non-superposable on it." ;
                        rdfs:label "chirality" .


###  http://semanticscience.org/resource/CHEMINF_000014
resource:CHEMINF_000014 rdf:type owl:Class ;
                        rdfs:subClassOf obo:IAO_0000098 ;
                        dcterms:description "A chemical entity information format specification is an information content entity which specifies a format in which information about a molecular entity should be encoded." ;
                        rdfs:label "chemical entity information format specification" .


###  http://semanticscience.org/resource/CHEMINF_000015
resource:CHEMINF_000015 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000229 ;
                        dcterms:description "partial negative surface area * total negative charge on the molecule" ;
                        cheminf-core:short_name "PNSA-2" ;
                        rdfs:label "PNSA-2" .


###  http://semanticscience.org/resource/CHEMINF_000016
resource:CHEMINF_000016 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "An energetic descriptor is a chemical descriptor which captures information about some aspect of the energetic behaviour of a chemical entity." ;
                        rdfs:label "energetic descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000017
resource:CHEMINF_000017 rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:IAO_0000136 ;
