                                          owl:someValuesFrom resource:CHEMINF_000472
                                        ] ;
                        dcterms:description "A preferred name is a molecular entity name which is preferred, or recommended, for usage in textual annotations referring to that molecular entity." ;
                        rdfs:label "preferred name" .


