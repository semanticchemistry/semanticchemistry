                        rdfs:label "neutron count" .


###  http://semanticscience.org/resource/CHEMINF_000079
resource:CHEMINF_000079 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000209 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
