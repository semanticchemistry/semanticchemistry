###  http://semanticscience.org/resource/CHEMINF_000413
resource:CHEMINF_000413 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description """A descriptor of the ratio of the amount of a given chemical substance
    adsorbed per unit weight of organic carbon in soil or sediment to the concentration
    of the chemical substance in solution at equilibrium.
    """ ;
                        rdfs:label "organic carbon adsorption descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000414
resource:CHEMINF_000414 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the ratio of the concentration of a chemical substance in an organism immersed in water to that in the surrounding water at equilibrium." ;
                        rdfs:label "bioconcentration factor descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000415
resource:CHEMINF_000415 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the volume occupied by one mole of the given substance at a given temperature and pressure." ;
                        rdfs:label "molar volume descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000416
resource:CHEMINF_000416 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the density of a given substance at a given temperature and pressure." ;
                        rdfs:label "density descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000417
resource:CHEMINF_000417 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ,
                                        resource:CHEMINF_000513 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description """A descriptor of the flash point of a substance at a given pressure.
    The flash point is the minimum temperature at which a mixture of the substance with air can be ignited, within its explosive range.""" ;
                        rdfs:label "flash point descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000418
resource:CHEMINF_000418 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the energy taken in by a chemical substance on vaporization at a given temperature and pressure." ;
                        rdfs:label "enthalpy of vaporization descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000419
resource:CHEMINF_000419 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the pressure exerted by the vapour phase of a chemical substance on its condensed phase at a given temperature and pressure." ;
                        rdfs:label "vapour pressure descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000420
resource:CHEMINF_000420 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000025 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "A descriptor of the disposition of a portion of liquid to resist a force." ;
                        rdfs:label "surface tension descriptor" .


