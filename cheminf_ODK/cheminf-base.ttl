                        owl:inverseOf resource:CHEMINF_000453 ;
                        rdfs:domain obo:GO_0005515 ;
                        rdfs:label "has_protein_binding_participant" .


###  http://semanticscience.org/resource/CHEMINF_000453
resource:CHEMINF_000453 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0000056 ;
                        rdfs:range obo:GO_0005515 ;
                        rdfs:label "participates_in_protein_binding" .


###  http://semanticscience.org/resource/CHEMINF_000454
resource:CHEMINF_000454 rdf:type owl:ObjectProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:PR_000000001 ;
                        owl:propertyChainAxiom ( resource:CHEMINF_000453
                                                 resource:CHEMINF_000452
                                               ) ;
                        rdfs:label "ligates" .


###  http://semanticscience.org/resource/CHEMINF_000455
resource:CHEMINF_000455 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000462 ;
                        rdf:type owl:SymmetricProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "An isotopologue is a molecular entity that differs only in isotopic composition from another molecular entity. (AU:I03351)" ;
                        rdfs:label "is_isotopologue_of" .


###  http://semanticscience.org/resource/CHEMINF_000456
resource:CHEMINF_000456 rdf:type owl:ObjectProperty ;
                        owl:inverseOf resource:CHEMINF_000491 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Subclass relation between a class that has stereochemistry defined and an otherwise identical class that does not." ;
                        rdfs:label "has_stereoundefined_parent" .


###  http://semanticscience.org/resource/CHEMINF_000457
resource:CHEMINF_000457 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Connects a molecule to a normalized counterpart of the same molecule according to an algorithm." ;
                        rdfs:comment "Caution: The number of moieties in the first molecule may be greater than in the second molecule. Example: salts." ,
                                     "Caution: this is not a subclass relation and should not be thought of as such for reasoning purposes." ;
                        rdfs:label "has_normalized_counterpart" .


###  http://semanticscience.org/resource/CHEMINF_000458
resource:CHEMINF_000458 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000457 ;
                        owl:inverseOf resource:CHEMINF_000494 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "This connects a molecule to its normalized counterpart according to the OPS specification." ;
                        rdfs:label "has OPS normalized counterpart" .


###  http://semanticscience.org/resource/CHEMINF_000459
resource:CHEMINF_000459 rdf:type owl:ObjectProperty ;
                        owl:inverseOf resource:CHEMINF_000489 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Subclass relation between a class that has isotopes specified, for example D2O or 14C-urea, and an otherwise identical class that does not, for example water or urea." ;
                        rdfs:label "has_isotopically_unspecified_parent" .


###  http://semanticscience.org/resource/CHEMINF_000460
resource:CHEMINF_000460 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        owl:inverseOf resource:CHEMINF_000495 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Connects a molecule to molecule with identical heavy-atom connectivity which is neutral. It is not a subclass relation." ;
                        rdfs:label "has_uncharged_counterpart" .


###  http://semanticscience.org/resource/CHEMINF_000461
resource:CHEMINF_000461 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000462 ;
                        rdf:type owl:SymmetricProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Connects a molecule to an isomer with identical constitution but differing in its arrangement of atoms in space. (AU:S05984)" ;
                        rdfs:label "is_stereoisomer_of" .


###  http://semanticscience.org/resource/CHEMINF_000462
resource:CHEMINF_000462 rdf:type owl:ObjectProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Connects a molecule to an isomer with identical constitution." ;
                        rdfs:label "has_same_connectivity_as" .


###  http://semanticscience.org/resource/CHEMINF_000463
resource:CHEMINF_000463 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000461 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        dcterms:description "Connects a molecule to a stereoisomer which is not its enantiomer." ;
                        rdfs:label "is_diastereomer_of" .


###  http://semanticscience.org/resource/CHEMINF_000477
resource:CHEMINF_000477 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000457 ;
                        obo:IAO_0000115 "This connects a molecule to its normalized counterpart according to the PubChem specification." ;
                        rdfs:label "has PubChem normalized counterpart" .


###  http://semanticscience.org/resource/CHEMINF_000478
resource:CHEMINF_000478 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:BFO_0000051 ;
                        rdfs:domain resource:CHEMINF_000266 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000115 "Has as member parts (see BFO 2 Graz for more on this) many molecular entities." ;
                        rdfs:comment "This connects entities at different granularities." ;
                        rdfs:label "has component" .


###  http://semanticscience.org/resource/CHEMINF_000479
resource:CHEMINF_000479 rdf:type owl:ObjectProperty ;
                        obo:IAO_0000115 "Connects a molecular entity to another molecular entity according to some specification." ;
                        rdfs:comment "This is intended to capture the case where a database has ad hoc relations between molecules that are not necessarily subclass relations." ;
                        rdfs:label "has counterpart molecular entity" .


###  http://semanticscience.org/resource/CHEMINF_000480
resource:CHEMINF_000480 rdf:type owl:ObjectProperty ;
                        owl:inverseOf resource:CHEMINF_000492 ;
                        rdfs:domain resource:CHEMINF_000266 ;
                        rdfs:range obo:CHEBI_23367 ;
                        owl:propertyChainAxiom ( resource:CHEMINF_000478
                                                 resource:CHEMINF_000460
                                               ) ;
                        obo:IAO_0000115 "Connects a molecular substance, say a mixture containing ions, with a neutral form of one of the ions." ;
                        rdfs:label "has component with uncharged counterpart" .


###  http://semanticscience.org/resource/CHEMINF_000481
resource:CHEMINF_000481 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        obo:IAO_0000115 "Connects a molecular entity that is deemed similar to another according to some algorithm." ;
                        rdfs:comment "not transitive, obviously" ;
                        rdfs:label "similar to" .


###  http://semanticscience.org/resource/CHEMINF_000482
resource:CHEMINF_000482 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000481 ;
                        obo:IAO_0000115 "Has a Tanimoto score with the counterpart molecular entity of more than 0.9, based on the PubChem fingerprint specification." ;
                        rdfs:comment "http://pubchem.ncbi.nlm.nih.gov/help.html#tanimoto" ;
                        rdfs:label "similar to by PubChem 2D similarity algorithm" .


###  http://semanticscience.org/resource/CHEMINF_000483
resource:CHEMINF_000483 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000481 ;
                        obo:IAO_0000115 "Has a 3D Tanimoto score with the counterpart molecule where the 3D shape similarity for the two is greater than 0.795 and the 3D feature score is greater than 0.495 or there are no features and the 3D shape similarity is greater than 0.925, where the shape similarity ST is calculated by ST=VAB/(VAA+VBB-VAB), where VAA and VBB are self-overlap volume of conformers A and B, and VAB is the common overlap volume between them and the feature score CT is calculated by CT=sum(VfAB)/(sum(VfAA)+sum(VfBB)-sum(VfAB)), where the superscript f indicates any of the six independent fictitious feature atom types, VfAA and VfBB are the respective self-overlap volumes of conformers A and B for feature atom type f, and VfAB is the overlap volume of conformers A and B for feature type f." ;
                        rdfs:comment "http://dx.doi.org/10.1186/1758-2946-3-32" ;
                        rdfs:label "similar to by PubChem 3D similarity algorithm" .


###  http://semanticscience.org/resource/CHEMINF_000486
resource:CHEMINF_000486 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0018036 ;
                        owl:inverseOf resource:CHEMINF_000493 ;
                        obo:IAO_0000115 "A exists in an equilibrium with B at pH 7.4 and physiological temperature and B is the dominant isomer." ;
                        rdfs:label "has major tautomer at pH 7.4" .


###  http://semanticscience.org/resource/CHEMINF_000489
resource:CHEMINF_000489 rdf:type owl:ObjectProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "Superclass relation between a class does not have isotopes specified, such as water or urea, and a class that does, such as D2O or 14C-urea." ;
                        rdfs:label "is_isotopically_unspecified_parent_of"@en .


###  http://semanticscience.org/resource/CHEMINF_000491
resource:CHEMINF_000491 rdf:type owl:ObjectProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        dcterms:description "Superclass relation between a class that does not have stereochemistry defined and another otherwise identical one that does." ;
                        rdfs:label "is_stereoundefined_parent_of"@en .


###  http://semanticscience.org/resource/CHEMINF_000492
resource:CHEMINF_000492 rdf:type owl:ObjectProperty ;
                        obo:IAO_0000115 "Connects a neutral molecule with a salt." ;
                        rdfs:comment "This is here because Open PHACTS has requested an inverse. Use with caution!" ;
                        rdfs:label "is component with uncharged counterpart of"@en .


###  http://semanticscience.org/resource/CHEMINF_000493
resource:CHEMINF_000493 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0018036 ;
                        obo:IAO_0000115 "A exists in an equilibrium with B at pH 7.4 and physiological temperature and A is the dominant isomer." ;
                        rdfs:label "is major tautomer at pH 7.4 of"@en .


###  http://semanticscience.org/resource/CHEMINF_000494
resource:CHEMINF_000494 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        obo:IAO_0000115 "If A 'is OPS normalized counterpart of' B, then A is the molecular entity corresponding to the connection table obtained by applying OPS normalization to the connection table of B." ;
                        rdfs:label "is OPS normalized counterpart of"@en .


###  http://semanticscience.org/resource/CHEMINF_000495
resource:CHEMINF_000495 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        obo:IAO_0000115 "If A 'is uncharged counterpart of' B, then A is the neutral species corresponding to B. B may itself of course be neutral." ;
                        rdfs:label "is uncharged counterpart of"@en .


###  http://semanticscience.org/resource/CHEMINF_000497
resource:CHEMINF_000497 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000462 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000115 "If A 'is a counterpart with different charge of' B, then A is an otherwise identical species to B but for charge." ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        rdfs:label "is counterpart with different charge of"@en .


###  http://semanticscience.org/resource/CHEMINF_000498
resource:CHEMINF_000498 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf resource:CHEMINF_000479 ;
                        rdf:type owl:SymmetricProperty ,
                                 owl:TransitiveProperty ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000115 """If A 'shares OPS normalized parent with' B,
then A 'has OPS normalized counterpart' C and B 'has OPS normalized counterpart' C.""" ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        rdfs:label "shares OPS normalized parent with"@en .


###  http://semanticscience.org/resource/CHEMINF_000499
resource:CHEMINF_000499 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0018036 ;
                        owl:inverseOf resource:CHEMINF_000514 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000115 "If A 'has ChemAxon canonicalised tautomer' B then B is the molecular entity corresponding to the output of ChemAxon's canonical tautomer generation algorithm applied to the connection table of A." ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        rdfs:comment "A and B can be identical." ;
                        rdfs:label "has ChemAxon canonicalised tautomer"@en .


###  http://semanticscience.org/resource/CHEMINF_000514
resource:CHEMINF_000514 rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf obo:RO_0018036 ;
                        rdfs:domain obo:CHEBI_23367 ;
                        rdfs:range obo:CHEBI_23367 ;
                        obo:IAO_0000115 "If B 'has ChemAxon canonicalised tautomer' A then B is the molecular entity corresponding to the output of ChemAxon's canonical tautomer generation algorithm applied to the connection table of A." ;
                        obo:IAO_0000117 "Colin Batchelor" ;
                        rdfs:comment "A and B can be identical." ;
                        rdfs:label "is ChemAxon canonicalised tautomer of"@en .


###  http://semanticscience.org/resource/CHEMINF_000606
resource:CHEMINF_000606 rdf:type owl:ObjectProperty ;
                        rdfs:domain obo:IAO_0000027 ;
                        rdfs:range obo:IAO_0000064 ;
                        rdfs:label "is execution output of" .


###  http://www.semanticweb.org/ontologies/is_output_of
ontologies:is_output_of rdf:type owl:ObjectProperty .


