resource:CHEMINF_000058 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000057 ;
                        dcterms:description "A MOLfile is a file which contains a MOLfile encoding of a chemical structure representation. It is the concretization of a MOLfile descriptor." ;
                        rdfs:label "MOLfile" .


###  http://semanticscience.org/resource/CHEMINF_000059
resource:CHEMINF_000059 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000061 ,
                                        resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000066 ;
                        rdfs:label "InChIKey" .


