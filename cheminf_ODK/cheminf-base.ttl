resource:CHEMINF_000248 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "Relative permittivity is a chemical substance quality that reflects the ability of a medium composed of molecules of a given type to transmit an electric field." ;
                        rdfs:label "relative permittivity" .


###  http://semanticscience.org/resource/CHEMINF_000249
resource:CHEMINF_000249 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
