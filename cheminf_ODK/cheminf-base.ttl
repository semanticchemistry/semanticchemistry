                        rdfs:subClassOf resource:CHEMINF_000140 ;
                        rdfs:label "PubChem conformer identifier"@en .


###  http://semanticscience.org/resource/CHEMINF_000235
resource:CHEMINF_000235 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "The disposition to dissociate is the disposition of an ionic compound (complexes, or salts) to separate or split into smaller particles, ions, or radicals, usually in a reversible manner." ;
                        rdfs:label "disposition to dissociate" .


###  http://semanticscience.org/resource/CHEMINF_000236
resource:CHEMINF_000236 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "The linear, surface, or volume charge density is the amount of electric charge in a line, surface, or volume  respectively. [source: Wikipedia, http://en.wikipedia.org/wiki/Charge_density]" ;
                        rdfs:label "charge density" .


###  http://semanticscience.org/resource/CHEMINF_000237
resource:CHEMINF_000237 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000056 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:boolean
                                        ] ;
                        dcterms:description "A bond aromaticity descriptor is an aromaticity descriptor associated with a bond within a chemical entity which indicates whether that  bond belongs to an aromatic system." ;
                        rdfs:label "bond aromaticity descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000238
resource:CHEMINF_000238 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "The meltability of a chemical substance is a quality which inheres in the chemical substance by virtue of the ease with which the substance can be changed from a solid to a liquid state especially by the application of heat." ;
                        oboInOwl:hasSynonym "fusibility" ;
                        rdfs:label "meltability" .


###  http://semanticscience.org/resource/CHEMINF_000239
resource:CHEMINF_000239 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000207 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000259
                                        ] ;
                        dcterms:description "The formation Gibbs energy descriptor captures the Gibbs energy associated with the formation of a molecular entity, relative to the standard state of constituent atoms. This can be measured, calculated in vacuo, or calculated with respect to a specific solvent, at a particular temperature and pressure. When calculated, the formation Gibbs energy value depends on the molecular conformation." ;
                        rdfs:label "formation Gibbs energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000240
resource:CHEMINF_000240 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000246 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "The largest aliphatic chain size descriptor is a count descriptor that gives the integer length (number of atoms) in the largest unbranched chain of atoms that does not contain aromatic atoms, within a given molecular entity." ;
                        rdfs:label "size of largest aliphatic chain" .


###  http://semanticscience.org/resource/CHEMINF_000241
resource:CHEMINF_000241 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000207 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000259
                                        ] ;
                        obo:IAO_0000118 "enthalpy of formation" ,
                                        "heat of formation" ;
                        dcterms:description "Molecular entity formation enthaply descriptor captures the enthalpy associated with the formation of the molecular entity in question, relative to the standard state of constituent atoms. This could be measured or calculated in vacuo or in a specific Solvent, at a particular temperature and pressure. Depends on molecular conformation when computed." ;
                        rdfs:label "formation enthalpy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000242
resource:CHEMINF_000242 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000060 ,
                                        resource:CHEMINF_000065 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000222
                                        ] ;
                        dcterms:description "A volume descriptor is a descriptor which describes a measure or calculation of the volume of a chemical entity." ;
                        rdfs:label "volume descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000243
resource:CHEMINF_000243 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000233 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "A descriptor that provides the integer count of aromatic bonds in a given molecular entity." ;
                        rdfs:label "aromatic bond count" .


###  http://semanticscience.org/resource/CHEMINF_000244
resource:CHEMINF_000244 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000209 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000230
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "A descriptor that reflects the integer number of hydrogen bond donors in a given molecular entity, as determined by a given method. In highly simplified terms, this is usually the count of all negatively or partially negatively charged heteroatoms (e.g. alcohol oxygen) that have covalently attached to them partially positively charged hydrogen atoms that are capable of participating in a hydrogen bond." ;
                        rdfs:label "hydrogen bond donor count" .


###  http://semanticscience.org/resource/CHEMINF_000245
resource:CHEMINF_000245 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000209 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "A descriptor that reflects the integer number of hydrogen bond acceptors in a given molecular entity, as determined by a given method. In highly simplified terms, this is usually the count of all negatively or partially negatively charged heteroatoms (e.g. alcohol oxygen) capable of accepting a hydrogen bond." ;
                        rdfs:label "hydrogen bond acceptor count" .


###  http://semanticscience.org/resource/CHEMINF_000246
