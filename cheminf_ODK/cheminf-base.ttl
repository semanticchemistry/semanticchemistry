###  http://semanticscience.org/resource/CHEMINF_000199
resource:CHEMINF_000199 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000032 ;
                        dcterms:description "An absolute SMILES descriptor is an isomeric SMILES descriptor that is produced using a canonicalization algorithm. " ;
                        rdfs:label "absolute SMILES descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000202
resource:CHEMINF_000202 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000209 ;
                        dcterms:description "a count descriptor that denotes the number of tautomers." ;
                        rdfs:label "tautomer count"@en .


###  http://semanticscience.org/resource/CHEMINF_000203
resource:CHEMINF_000203 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000209 ;
                        rdfs:label "stereocenter count"@en .


###  http://semanticscience.org/resource/CHEMINF_000205
resource:CHEMINF_000205 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000203 ;
                        owl:disjointWith resource:CHEMINF_000213 ;
                        rdfs:label "atom stereocenter count"@en .


###  http://semanticscience.org/resource/CHEMINF_000206
resource:CHEMINF_000206 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000205 ;
                        rdfs:label "defined atom stereocenter count"@en .


###  http://semanticscience.org/resource/CHEMINF_000207
resource:CHEMINF_000207 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000016 ;
                        dcterms:description "A formation energy descriptor is an energetic descriptor which gives the value for the energy of formation of a chemical entity." ;
                        rdfs:label "formation energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000208
resource:CHEMINF_000208 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000016 ;
                        dcterms:description "A solvation energy descriptor is a chemical descriptor which gives the value for the energy of dissolving a particular chemical entity in a solvent." ;
                        rdfs:label "solvation energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000209
resource:CHEMINF_000209 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000136 ;
                        dcterms:description "A count descriptor is a chemical descriptor which is calculated by counting the number of features of a certain kind which are present in the chemical entity." ;
                        rdfs:label "count descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000210
resource:CHEMINF_000210 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000016 ;
                        dcterms:description "A dissociation energy descriptor is an energetic descriptor which gives a value for the dissociation energy for a chemical entity." ;
                        rdfs:label "dissociation energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000211
resource:CHEMINF_000211 rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000019 ;
                        dcterms:description "A dimensional extent quality is a quality that inheres in a molecular entity by virtue of a measurement of length, area or volume in a one, two or three dimensional extent." ;
                        rdfs:label "dimensional extent quality" .


###  http://semanticscience.org/resource/CHEMINF_000212
resource:CHEMINF_000212 rdf:type owl:Class ;
