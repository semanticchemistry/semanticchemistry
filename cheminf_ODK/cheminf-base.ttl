resource:CHEMINF_000214 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000213 ;
                        rdfs:label "defined bond stereocenter count"@en .


###  http://semanticscience.org/resource/CHEMINF_000215
resource:CHEMINF_000215 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000213 ;
                        rdfs:label "undefined bond stereocenter count"@en .


###  http://semanticscience.org/resource/CHEMINF_000216
resource:CHEMINF_000216 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000088 ;
                        dcterms:description "The mass of a molecule calculated using the average mass of each element weighted for its natural isotopic abundance. E.g., Carbon has two natural isotopes 12 and 13 with relative abundances of 98.9% and 1.1% to yield an average mass of 12.011 g/mol" ;
                        rdfs:label "average molecular weight descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000217
resource:CHEMINF_000217 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000088 ;
                        dcterms:description "an exact mass descriptor corresponds to the mass of the most intense molecule/ion peak in an MS spec, and when calculated denotes the mass of an ion or a molecule containing most likely isotopic composition for a single random molecule." ;
                        rdfs:label "exact mass descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000218
resource:CHEMINF_000218 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000088 ;
                        dcterms:description "The mass of a molecule calculated using the mass of the most abundant isotope of each element. E.g., Carbon has a monoisotopic mass of 12.000 g/mol." ;
                        rdfs:label "monoisotopic mass descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000219
resource:CHEMINF_000219 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000085 ;
                        dcterms:description "A complexity descriptor denotes the how complicated a structure is, seen from both the point of view of the elements contained and its structural features ." ;
                        rdfs:label "complexity descriptor"@en .


###  http://semanticscience.org/resource/CHEMINF_000220
resource:CHEMINF_000220 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000028 ;
                        rdfs:label "cis-trans stereochemistry specification" .


###  http://semanticscience.org/resource/CHEMINF_000221
resource:CHEMINF_000221 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000450 ;
                        obo:IAO_0000115 """Fragment Method used for the calculation of ALogP as defined by Ghose and Crippen.

Ghose, A.K., Viswanadhan V.N., and Wendoloski, J.J., Prediction of Hydrophobic (Lipophilic) Properties of Small Organic Molecules Using Fragment Methods: An Analysis of AlogP and CLogP Methods. J. Phys. Chem. A, 1998, 102, 3762-3772.

""" ;
                        rdfs:label "Ghose/Crippen ALogP calculation algorithm" .


