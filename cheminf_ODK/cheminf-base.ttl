resource:CHEMINF_000086 rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000019 ;
                        dcterms:description "A chemical quality is a quality that inheres in a molecular entity or aggregate molecular substance." ;
                        rdfs:label "chemical quality" .


