                                          owl:someValuesFrom resource:CHEMINF_000258
                                        ] ;
                        dcterms:description "The molecular entity solvation entropy descriptor reflects the entropy associated with the solvation of the molecular entity in question. This could be measured or calculated in vacuo or in a specific solvent, at a particular temperature and pressure. Depends on molecular conformation when computed." ;
                        rdfs:label "solvation entropy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000250
