resource:CHEMINF_000060 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000093 ;
                        dcterms:description "A dimensional extent descriptor is a physical property descriptor which describes some measurable length, area or volume aspect of a chemical entity." ;
                        rdfs:label "dimensional extent descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000061
resource:CHEMINF_000061 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "An identifying descriptor is a chemical descriptor which provides an identifier for the chemical entity it is about, which in most cases should aim to be unique and easy to use as an unambiguous reference for the chemical entity." ;
                        rdfs:label "identifying descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000062
resource:CHEMINF_000062 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000093 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom resource:CHEMINF_000063
                                        ] ;
                        dcterms:description "A bond order descriptor is a descriptor associated with a bond in a chemical entity which indicates the order of the bond (single, double or triple)." ;
                        rdfs:label "bond order descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000063
resource:CHEMINF_000063 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000000 ;
                        rdfs:label "chemical bond" .


###  http://semanticscience.org/resource/CHEMINF_000064
resource:CHEMINF_000064 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A Quantitative Structure Activity Relationship (QSAR) descriptor is a chemical descriptor which gives a numeric, quantitative value which is believed to be associated with some aspect of the chemical or biological activity of the chemical entity." ;
                        oboInOwl:hasAlternativeId "BODO:Descriptor" ;
                        rdfs:comment "NOTE: QSAR descriptors are often just called 'chemical descriptor' or 'molecular descriptor' in the cheminformatics community." ;
                        rdfs:label "QSAR descriptor" .


