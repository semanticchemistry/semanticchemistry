                        cheminf-core:short_name "LargestPiSystem" ;
                        rdfs:label "pi-system size" .


###  http://semanticscience.org/resource/CHEMINF_000224
resource:CHEMINF_000224 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000210 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom resource:CHEMINF_000063
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000235
                                        ] ;
                        dcterms:description "Bond dissociation Gibbs energy descriptor captures the Gibbs energy associated with the process of breaking the bond in question. This could be measured or calculated in vacuo or in a specific Solvent, at a given temperature and pressure. Depends on molecular conformation." ;
                        rdfs:label "bond dissociation Gibbs energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000225
resource:CHEMINF_000225 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000208 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000258
                                        ] ;
                        dcterms:description "The molecular entity solvation Gibbs energy descriptor reflects the Gibbs energy associated with the solvation of the molecular entity in question. This could be measured or calculated in vacuo or in a specific solvent, at a particular temperature and pressure. Depends on molecular conformation when computed." ;
                        rdfs:label "solvation Gibbs energy descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000226
resource:CHEMINF_000226 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000231 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom resource:CHEMINF_000063
                                        ] ;
                        rdfs:label "bond charge density descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000227
resource:CHEMINF_000227 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000211 ;
                        dcterms:description "A three dimensional extent is a dimensional extent in three dimensions, e.g. a volume." ;
                        rdfs:label "3-D extent" .


###  http://semanticscience.org/resource/CHEMINF_000228
resource:CHEMINF_000228 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000404 ;
                        dcterms:description "The refractive index of a chemical substance is a measure of the manner in which  light waves are bent when they enter the medium of the chemical substance." ;
                        rdfs:label "refractive index" .


###  http://semanticscience.org/resource/CHEMINF_000229
resource:CHEMINF_000229 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000060 ,
                                        resource:CHEMINF_000065 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000247
                                        ] ;
                        dcterms:description "A surface area descriptor is a descriptor which describes a measure or calculation of the surface area of a chemical entity." ;
                        rdfs:label "surface area descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000230
resource:CHEMINF_000230 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        rdfs:comment "From PATO." ;
                        rdfs:label "composition" .


###  http://semanticscience.org/resource/CHEMINF_000231
resource:CHEMINF_000231 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000087 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000236
                                        ] ;
                        dcterms:description "A charge density descriptor is a chemical entity descriptor which indicates the distribution of the electric charge over the volume of the chemical entity." ;
                        rdfs:label "charge density descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000232
resource:CHEMINF_000232 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000263 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000012 ;
                                          owl:someValuesFrom xsd:int
                                        ] ;
                        dcterms:description "A descriptor that provides the integer count of aromatic atoms in a given molecular entity." ;
                        rdfs:label "aromatic atom count" .


###  http://semanticscience.org/resource/CHEMINF_000233
resource:CHEMINF_000233 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000209 ,
                                        [ rdf:type owl:Restriction ;
