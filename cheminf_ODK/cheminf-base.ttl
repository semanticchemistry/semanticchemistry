                                          owl:onProperty obo:IAO_0000136 ;
                                          owl:someValuesFrom resource:CHEMINF_000000
                                        ] ;
                        rdfs:label "information about a chemical entity" .


###  http://semanticscience.org/resource/CHEMINF_000018
resource:CHEMINF_000018 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000085 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000047 ;
                                          owl:someValuesFrom resource:CHEMINF_000020
                                        ] ;
                        dcterms:description "A SMILES descriptor is a structure descriptor that denotes a molecular structure as a graph." ;
                        rdfs:label "SMILES descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000019
resource:CHEMINF_000019 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000085 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000047 ;
                                          owl:someValuesFrom resource:CHEMINF_000021
                                        ] ;
                        dcterms:description "A SMARTS descriptor is a molecular structure descriptor that conforms to the SMARTS specification." ;
                        rdfs:label "SMARTS descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000020
resource:CHEMINF_000020 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000035 ;
                        dcterms:description "The simplified molecular input line entry specification (SMILES) is a specification for unambiguously describing the structure of chemical molecules using short ASCII strings. SMILES strings can be imported by most molecule editors for conversion back into two-dimensional drawings or three-dimensional models of the molecules (source:wikipedia)." ;
                        rdfs:label "SMILES format specification" .


###  http://semanticscience.org/resource/CHEMINF_000021
resource:CHEMINF_000021 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000035 ;
                        dcterms:description "Smiles ARbitrary Target Specification (SMARTS) is a language for specifying substructural patterns in molecules. The SMARTS line notation is expressive and allows extremely precise and transparent substructural specification and atom typing (source:Wikipedia)" ;
                        rdfs:label "SMARTS format specification" .


###  http://semanticscience.org/resource/CHEMINF_000022
resource:CHEMINF_000022 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000014 ;
                        dcterms:description "A molecular structure encoding format specification is a molecular entity format specification which specifies a format in which a molecular structure information entity may be encoded." ;
                        rdfs:label "molecular structure encoding format specification" .


###  http://semanticscience.org/resource/CHEMINF_000023
resource:CHEMINF_000023 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000022 ;
                        dcterms:description "A molecular stereochemistry format specification is a molecular structure format specification that specifies how to encode the stereochemical aspects of a molecular structure." ;
                        rdfs:label "molecular stereochemistry format specification" .


###  http://semanticscience.org/resource/CHEMINF_000024
resource:CHEMINF_000024 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000028 ;
                        rdfs:label "RS stereochemistry specification" .


###  http://semanticscience.org/resource/CHEMINF_000025
resource:CHEMINF_000025 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A physical descriptor is a chemical descriptor which describes some physical property (quality or disposition) of a chemical entity." ;
                        rdfs:label "physical descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000026
resource:CHEMINF_000026 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000028 ;
                        rdfs:label "DL stereochemistry specification" .


###  http://semanticscience.org/resource/CHEMINF_000027
resource:CHEMINF_000027 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000013
                                        ] ;
                        dcterms:description "A stereochemical descriptor is a chemical descriptor which describes some aspect of the three dimensional structure of a chemical entity." ;
                        rdfs:label "stereochemical descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000028
resource:CHEMINF_000028 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000023 ;
                        dcterms:description "A specification of stereochemistry by configuration specifies a format in which the stereochemistry of a molecule should be encoded with reference to the configuration of attachments around the stereogenic centre." ;
                        rdfs:label "specification of stereochemistry by configuration" .


###  http://semanticscience.org/resource/CHEMINF_000029
resource:CHEMINF_000029 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000023 ;
                        dcterms:description "A specification of stereochemistry by optical activity specifies a format by which the stereochemistry of a molecule should be encoded by reference to the observable optical activity of a chiral molecule." ;
                        rdfs:label "specification of stereochemistry by optical activity" .


###  http://semanticscience.org/resource/CHEMINF_000030
resource:CHEMINF_000030 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000029 ;
                        rdfs:label "+/- stereochemistry specification" .


###  http://semanticscience.org/resource/CHEMINF_000031
resource:CHEMINF_000031 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000086 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty obo:RO_0000052 ;
                                          owl:someValuesFrom obo:CHEBI_23367
                                        ] ;
                        dcterms:description "A molecular entity quality is a quality which inheres in a molecular entity." ;
                        rdfs:label "molecular entity quality" .


###  http://semanticscience.org/resource/CHEMINF_000032
resource:CHEMINF_000032 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000018 ;
                        dcterms:description "an isomeric SMILES descriptor is a SMILES descriptor that written with isotopic and chiral specifications." ;
                        rdfs:label "isomeric SMILES descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000033
resource:CHEMINF_000033 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000031 ;
                        dcterms:description "Molecular structure is a molecular entity quality that inheres in a molecule by virtue of its shape - the way in which the atoms which constitute the molecule are bonded together and the shape which they therefore form." ;
                        rdfs:label "molecular structure" .


###  http://semanticscience.org/resource/CHEMINF_000034
resource:CHEMINF_000034 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000005 ;
                        rdfs:label "S stereochemical descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000035
resource:CHEMINF_000035 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000022 ;
                        dcterms:description "An atomic connectivity molecular structure encoding format specification is a molecular structure encoding format specification which specifies a format in which the connectivity of atoms within a molecule may be specified." ;
                        rdfs:label "atomic connectivity molecular structure encoding format specification" .


###  http://semanticscience.org/resource/CHEMINF_000036
resource:CHEMINF_000036 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000014 ;
                        dcterms:description "A molecular composition format specification is a molecular entity information format specification which specifies a format in which a molecular composition may be encoded." ;
                        rdfs:label "molecular composition format specification" .


###  http://semanticscience.org/resource/CHEMINF_000037
resource:CHEMINF_000037 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000036 ;
                        rdfs:label "IUPAC chemical formula" .


###  http://semanticscience.org/resource/CHEMINF_000038
resource:CHEMINF_000038 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000035 ;
                        dcterms:description "The IUPAC International Chemical Identifier (InChI) is a textual identifier  for chemical substances, designed to provide a standard and human-readable way to encode molecular information and to facilitate the search for such information in databases and on the web. Developed by IUPAC and NIST during 2000-2005, the format and algorithms are non-proprietary and the software is freely available under the open source LGPL license (though the term \"InChI\" is a trademark  of IUPAC). [source: Wikipedia, http://en.wikipedia.org/wiki/International_Chemical_Identifier]" ;
                        rdfs:label "InChI format specification" .


###  http://semanticscience.org/resource/CHEMINF_000039
resource:CHEMINF_000039 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000014 ;
                        dcterms:description "A molecular entity name format specification is a molecular entity information format specification which specifies a format in which a molecular entity name may be encoded." ;
                        rdfs:label "molecular entity name format specification" .


###  http://semanticscience.org/resource/CHEMINF_000040
resource:CHEMINF_000040 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000039 ;
                        rdfs:comment "http://www.iupac.org/web/ins/2001-043-1-800" ;
                        rdfs:label "Preferred IUPAC Name for Organic Compounds" .


###  http://semanticscience.org/resource/CHEMINF_000041
resource:CHEMINF_000041 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000123 ;
                        dcterms:description "A positional descriptor is a chemical descriptor which describes some aspect of the position, or location of a chemical entity, or of the relative parts of a chemical entity with respct to one another." ;
                        rdfs:label "positional descriptor" .


###  http://semanticscience.org/resource/CHEMINF_000042
resource:CHEMINF_000042 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000136 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000143 ;
                                          owl:someValuesFrom resource:CHEMINF_000054
                                        ] ;
                        dcterms:description "A molecular formula is a structure descriptor which identifies each constituent element by its chemical symbol and indicates the number of atoms of each element found in each discrete molecule of that compound." ;
                        rdfs:label "molecular formula" .


###  http://semanticscience.org/resource/CHEMINF_000043
resource:CHEMINF_000043 rdf:type owl:Class ;
                        rdfs:subClassOf resource:CHEMINF_000061 ,
                                        resource:CHEMINF_000065 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty resource:CHEMINF_000047 ;
                                          owl:someValuesFrom resource:CHEMINF_000039
                                        ] ;
                        dcterms:description "An information entity about a molecular entity which serves to name that molecular entity." ;
                        rdfs:label "molecular entity name" .


###  http://semanticscience.org/resource/CHEMINF_000044
resource:CHEMINF_000044 rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty obo:OBI_0000312 ;
                                              owl:someValuesFrom resource:CHEMINF_000472
                                            ] ;
                        rdfs:subClassOf resource:CHEMINF_000043 ,
