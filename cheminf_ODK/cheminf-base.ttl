                        rdfs:subClassOf resource:CHEMINF_000065 ,
                                        resource:CHEMINF_000085 ;
                        dcterms:description "A chemical connectivity table is a structure descriptor which consists of a connection table representing bonds between atoms in a molecular entity." ;
                        rdfs:label "chemical connectivity table" .


