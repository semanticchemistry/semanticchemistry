###  http://semanticscience.org/resource/CHEMINF_000066
resource:CHEMINF_000066 rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( resource:CHEMINF_000017
                                                                   [ rdf:type owl:Restriction ;
